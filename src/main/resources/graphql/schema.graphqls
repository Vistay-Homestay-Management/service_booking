type Query {
  bookingServiceInfo: BookingServiceInfo!
  booking(id: ID!): Booking!
  bookings(status: String, limit: Int = 50): [Booking!]!
  propertyRateProfileVersion(id: ID!): PropertyRateProfileVersion!
  propertyRateProfileVersions(propertyId: ID!): [PropertyRateProfileVersion!]!
  calculatePropertyPriceQuote(input: CalculatePropertyPriceQuoteInput!): PropertyPriceQuote!
}

type Mutation {
  createPropertyRateProfileVersion(input: CreatePropertyRateProfileVersionInput!): PropertyRateProfileVersion!
}

type Booking {
  id: ID!
  bookingCode: String!
  propertyId: ID!
  status: String!
  checkInDate: String!
  checkOutDate: String!
  totalAmount: String
  currency: String!
}

type BookingServiceInfo {
  name: String!
  version: String!
}

type PropertyRateProfileVersion {
  id: ID!
  propertyId: ID!
  version: Int!
  effectiveFrom: String!
  effectiveToExclusive: String
  baseDailyRate: String!
  mediumDailyFactorBps: Int!
  longDailyFactorBps: Int!
  currency: String!
  checkInTime: String!
  checkOutTime: String!
  turnoverMinutes: Int!
  quoteTtlMinutes: Int!
  commissionDefaultBps: Int!
  commissionMaxBps: Int!
  reason: String!
  authoredByAdminAccountId: ID!
  correlationId: String
  authoredAt: String!
  rules: [PricingRuleVersion!]!
}

type PricingRuleVersion {
  id: ID!
  code: String!
  name: String!
  effectiveFrom: String!
  effectiveToExclusive: String
  priority: Int!
  daysOfWeek: [Int!]!
  channels: [PricingChannel!]!
  minimumStayDays: Int
  maximumStayDays: Int
  minimumGuests: Int
  maximumGuests: Int
  actionType: PricingActionType!
  actionValue: String!
}

type PropertyPriceQuote {
  fingerprint: String!
  calculationVersion: String!
  roundingPolicy: String!
  rateProfileVersionId: ID!
  propertyId: ID!
  profileVersion: Int!
  checkInDate: String!
  checkOutDate: String!
  guestCount: Int!
  channel: PricingChannel!
  staffCreated: Boolean!
  stayProduct: StayProduct!
  stayDays: Int!
  baseDailyRate: String!
  dailyFactorBps: Int!
  productDailyRate: String!
  baseLodgingAmount: String!
  lodgingBeforeAdjustments: String!
  discountAmount: String!
  surchargeAmount: String!
  lodgingAmount: String!
  commissionBps: Int!
  requestedCommissionBps: Int
  commissionDefaultBps: Int!
  commissionMaxBps: Int!
  commissionBaseAmount: String!
  commissionAmount: String!
  totalAmount: String!
  currency: String!
  precedence: [String!]!
  evaluatedRules: [PricingRuleEvaluation!]!
  components: [PriceComponent!]!
}

type PricingRuleEvaluation {
  order: Int!
  chargeDate: String
  ruleId: ID!
  code: String!
  priority: Int!
  status: PricingRuleEvaluationStatus!
  reason: String!
  actionType: PricingActionType!
  actionValue: String!
  beforeAmount: String!
  adjustmentAmount: String!
  afterAmount: String!
}

type PriceComponent {
  order: Int!
  type: PriceComponentType!
  code: String!
  chargeDate: String
  ruleCode: String
  quantity: Int!
  unitAmount: String!
  factorBps: Int
  amount: String!
}

enum StayProduct {
  SHORT
  MEDIUM
  LONG
}

enum PricingRuleEvaluationStatus {
  MATCHED
  SKIPPED
  SUPERSEDED
}

enum PriceComponentType {
  PROFILE_BASE_RATE
  FIXED_DAILY_RATE
  STAY_PRODUCT_RATE
  RULE_DISCOUNT
  RULE_SURCHARGE
  COMMISSION
}

enum PricingChannel {
  ADMIN_PORTAL
  CUSTOMER_WEB
  OTA
}

enum PricingActionType {
  FIXED_DAILY_RATE
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
  PERCENT_SURCHARGE
  FIXED_SURCHARGE
}

input CreatePropertyRateProfileVersionInput {
  idempotencyKey: String!
  propertyId: ID!
  effectiveFrom: String!
  effectiveToExclusive: String
  baseDailyRate: String!
  mediumDailyFactorBps: Int = 7000
  longDailyFactorBps: Int = 5500
  checkInTime: String = "14:00"
  checkOutTime: String = "12:00"
  turnoverMinutes: Int = 120
  quoteTtlMinutes: Int = 15
  commissionDefaultBps: Int = 500
  commissionMaxBps: Int = 2000
  reason: String!
  correlationId: String
  rules: [PricingRuleVersionInput!]! = []
}

input PricingRuleVersionInput {
  code: String!
  name: String!
  effectiveFrom: String!
  effectiveToExclusive: String
  priority: Int!
  daysOfWeek: [Int!]! = []
  channels: [PricingChannel!]! = []
  minimumStayDays: Int
  maximumStayDays: Int
  minimumGuests: Int
  maximumGuests: Int
  actionType: PricingActionType!
  actionValue: String!
}

input CalculatePropertyPriceQuoteInput {
  rateProfileVersionId: ID!
  propertyId: ID!
  checkInDate: String!
  checkOutDate: String!
  guestCount: Int! = 1
  channel: PricingChannel!
  staffCreated: Boolean! = false
  commissionBps: Int
}
